{
  "name": "bko/bko",
  "type": "project",
  "version": "0.1.0",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.10"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "symfony/var-dumper": "^7.0",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Helpers/GetLogo.php",
      "src/Helpers/SkinSelect.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "dev": "php -S localhost:8000 -t public"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "process-timeout": 0
  }
}
